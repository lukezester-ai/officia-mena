# Database (STORAGE_POSTGRES_URL is preferred, with fallbacks for compatibility)
STORAGE_POSTGRES_URL="postgres://user:password@localhost:5432/officia"
# Alternative database URLs (fallbacks for compatibility - can be used instead of STORAGE_POSTGRES_URL)
# POSTGRES_URL="postgres://user:password@localhost:5432/officia"
# DATABASE_URL="postgres://user:password@localhost:5432/officia"
POSTGRES_POOL_MAX="10"

# Authentication
AUTH_SECRET="use-a-long-random-secret-change-this-in-production"
ENABLE_DEMO_LOGIN="false"

# Stripe
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# AI Providers
ANTHROPIC_API_KEY="sk-ant-..."
GOOGLE_GENERATIVE_AI_API_KEY="AIza..."
AI_GATEWAY_API_KEY="..."
AI_GATEWAY_PRIMARY_MODEL="anthropic/claude-sonnet-4.5"
AI_GATEWAY_FALLBACK_MODEL="google/gemini-2.5-flash"

# Cron Security
CRON_SECRET="use-a-long-random-secret-change-this-in-production"

# Email (Resend)
RESEND_API_KEY="re_..."
REPORT_FROM_EMAIL="Officia MENA <reports@your-verified-domain.com>"

# Open Banking
OPEN_BANKING_API_URL="https://your-certified-provider.example"
OPEN_BANKING_ACCESS_TOKEN="..."
OPEN_BANKING_CLIENT_ID="..."
OPEN_BANKING_TENANT_ID="tenant-uuid-owning-this-consent"
OPEN_BANKING_ENV="sandbox"
OPEN_BANKING_PROVIDER="generic-ob"
OPEN_BANKING_HEALTH_PATH="/health"
OPEN_BANKING_CONSENTS_PATH="/consents"
OPEN_BANKING_ACCOUNTS_PATH="/accounts"
OPEN_BANKING_TRANSACTIONS_PATH="/transactions"
OPEN_BANKING_PRODUCTION_ENABLED="false"

# ZATCA (Saudi Arabia E-Invoicing)
ZATCA_API_URL="https://gw-fatoora.zatca.gov.sa/e-invoicing/developer-portal"
ZATCA_CSID="..."
ZATCA_CSID_SECRET="..."
ZATCA_TENANT_ID="tenant-uuid-owning-this-csid"
ZATCA_ENV="sandbox"

# Sentry (Error Tracking)
SENTRY_DSN=""
SENTRY_AUTH_TOKEN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
NEXT_PUBLIC_SENTRY_DSN=""

# Environment
NODE_ENV="development"
VERCEL_ENV="development"
NEXT_DISABLE_BUILD_CACHE="false"
